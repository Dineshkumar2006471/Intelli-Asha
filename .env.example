# IntelliASHA — Environment Variables
# Copy this file to `.env` and fill in your project credentials.
# See: https://firebase.google.com/docs/web/setup#config-object

# ─── Firebase Project Configuration ──────────────────────────────────────
# Get from Firebase Console → Project Settings → General → Your apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# ─── Google Maps Platform ────────────────────────────────────────────────
# Get from Google Cloud Console → APIs & Services → Credentials
# Required APIs: Maps JavaScript API, Geocoding API, Places API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── Development Settings (optional) ────────────────────────────────────
# Set to "true" to use Firebase Emulators locally
# VITE_USE_EMULATORS=false

# ─── Server-Side Secrets (NOT in .env — stored in Secret Manager) ────────
# The following keys are managed via Google Cloud Secret Manager
# and accessed by Cloud Functions at runtime. Do NOT put them here:
#   - GEMINI_API_KEY (used by all 5 agents)
#   - GOOGLE_MAPS_SERVER_KEY (used by Verification Agent for geocoding)
