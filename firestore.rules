rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // Supervisors / DHOs sign in with Google; field workers use Phone OTP.
    function isSupervisor() {
      // PROD: Only users authenticated via Google (Supervisors/DHOs) can access dashboards
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isOwner(field) {
      return isAuthenticated()
        && resource.data[field] == request.auth.uid;
    }

    // ─── Visits (Verified) ─────────────────────────────────────────────
    // Written EXCLUSIVELY by the Field Agent (Cloud Function).
    match /visits/{visitId} {
      allow read:   if isOwner('workerId') || isSupervisor();
      allow create: if isAuthenticated()
                    && request.resource.data.workerId == request.auth.uid;
      allow update, delete: if false; // Cloud Functions only
    }

    // ─── Raw Visits (Pending) ──────────────────────────────────────────
    // Written by the frontend. Triggers the Field Agent.
    match /raw_visits/{visitId} {
      allow read:   if isOwner('workerId') || isSupervisor();
      allow create: if isAuthenticated()
                    && request.resource.data.workerId == request.auth.uid;
      allow update, delete: if false; // Cloud Functions only
    }

    // ─── Analytics ─────────────────────────────────────────────────────
    // Written by Analytics Agent. Read by DHOs.
    match /analytics/{docId} {
      allow read:   if isSupervisor();
      allow write:  if false; // Cloud Functions only
    }

    // ─── Alerts ────────────────────────────────────────────────────────
    // Created exclusively by the Alert Agent (Cloud Function).
    // Supervisors can read and update status (mark as read / dismissed).
    match /alerts/{alertId} {
      allow read:   if isSupervisor();
      allow update: if isSupervisor()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status']);
      allow create, delete: if false; // Cloud Functions only
    }

    // ─── Workers ───────────────────────────────────────────────────────
    // Any authenticated user can read worker profiles (needed for display).
    // A worker can only write to their own profile document.
    match /workers/{workerId} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.auth.uid == workerId;

      match /incentives/{docId} {
        allow read: if isAuthenticated() && request.auth.uid == workerId || isSupervisor();
        allow write: if false; // Incentive Agent only
      }

      match /smartRoute/{docId} {
        allow read: if isAuthenticated() && request.auth.uid == workerId;
        allow write: if false; // Triage Agent only
      }
    }

    // ─── Agent Logs ────────────────────────────────────────────────────
    // Written by Cloud Functions. Readable by supervisors for the
    // live agent-activity terminal on the Supervisor Dashboard.
    match /agent_logs/{logId} {
      allow read:  if isSupervisor();
      allow write: if false; // Cloud Functions only
    }

    // ─── A2A Tasks ─────────────────────────────────────────────────────
    // Inter-agent task queue. Fully managed by Cloud Functions.
    // Supervisors may read for observability.
    match /a2a_tasks/{taskId} {
      allow read:  if isSupervisor();
      allow write: if false; // Cloud Functions only
    }

    // ─── FCM Tokens ────────────────────────────────────────────────────
    // Each user stores their own push notification token.
    match /fcm_tokens/{userId} {
      allow read, write: if isAuthenticated()
                         && request.auth.uid == userId;
    }

    // ─── A2A Protocol Tasks ─────────────────────────────────────────────
    // Tasks created via the Google A2A protocol gateway.
    // Supervisors may read for observability.
    match /a2a_protocol_tasks/{taskId} {
      allow read:  if isSupervisor();
      allow write: if false; // Cloud Functions (A2A Gateway) only
    }
  }
}